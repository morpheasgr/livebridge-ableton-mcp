					"id": "obj-code",
					"maxclass": "codebox",
					"code": "// LiveBridge Engine analysis — generated by max_for_live/build.py, do not edit.\n// Inputs: left, right. Outputs (see OUTPUTS in build.py): mean squares, peaks,\n// K-weighted power, 8 band powers, mid/side/left*right, low-end mid/side.\n\nHistory ks_b0(0);\nHistory ks_b1(0);\nHistory ks_b2(0);\nHistory ks_a1(0);\nHistory ks_a2(0);\nHistory kh_b0(0);\nHistory kh_b1(0);\nHistory kh_b2(0);\nHistory kh_a1(0);\nHistory kh_a2(0);\nHistory lp_b0(0);\nHistory lp_b1(0);\nHistory lp_b2(0);\nHistory lp_a1(0);\nHistory lp_a2(0);\nHistory b0_b0(0);\nHistory b0_b1(0);\nHistory b0_b2(0);\nHistory b0_a1(0);\nHistory b0_a2(0);\nHistory b1_b0(0);\nHistory b1_b1(0);\nHistory b1_b2(0);\nHistory b1_a1(0);\nHistory b1_a2(0);\nHistory b2_b0(0);\nHistory b2_b1(0);\nHistory b2_b2(0);\nHistory b2_a1(0);\nHistory b2_a2(0);\nHistory b3_b0(0);\nHistory b3_b1(0);\nHistory b3_b2(0);\nHistory b3_a1(0);\nHistory b3_a2(0);\nHistory b4_b0(0);\nHistory b4_b1(0);\nHistory b4_b2(0);\nHistory b4_a1(0);\nHistory b4_a2(0);\nHistory b5_b0(0);\nHistory b5_b1(0);\nHistory b5_b2(0);\nHistory b5_a1(0);\nHistory b5_a2(0);\nHistory b6_b0(0);\nHistory b6_b1(0);\nHistory b6_b2(0);\nHistory b6_a1(0);\nHistory b6_a2(0);\nHistory b7_b0(0);\nHistory b7_b1(0);\nHistory b7_b2(0);\nHistory b7_a1(0);\nHistory b7_a2(0);\nHistory ksl_x1(0);\nHistory ksl_x2(0);\nHistory ksl_y1(0);\nHistory ksl_y2(0);\nHistory khl_x1(0);\nHistory khl_x2(0);\nHistory khl_y1(0);\nHistory khl_y2(0);\nHistory ksr_x1(0);\nHistory ksr_x2(0);\nHistory ksr_y1(0);\nHistory ksr_y2(0);\nHistory khr_x1(0);\nHistory khr_x2(0);\nHistory khr_y1(0);\nHistory khr_y2(0);\nHistory lpm_x1(0);\nHistory lpm_x2(0);\nHistory lpm_y1(0);\nHistory lpm_y2(0);\nHistory lps_x1(0);\nHistory lps_x2(0);\nHistory lps_y1(0);\nHistory lps_y2(0);\nHistory bf0_x1(0);\nHistory bf0_x2(0);\nHistory bf0_y1(0);\nHistory bf0_y2(0);\nHistory bf1_x1(0);\nHistory bf1_x2(0);\nHistory bf1_y1(0);\nHistory bf1_y2(0);\nHistory bf2_x1(0);\nHistory bf2_x2(0);\nHistory bf2_y1(0);\nHistory bf2_y2(0);\nHistory bf3_x1(0);\nHistory bf3_x2(0);\nHistory bf3_y1(0);\nHistory bf3_y2(0);\nHistory bf4_x1(0);\nHistory bf4_x2(0);\nHistory bf4_y1(0);\nHistory bf4_y2(0);\nHistory bf5_x1(0);\nHistory bf5_x2(0);\nHistory bf5_y1(0);\nHistory bf5_y2(0);\nHistory bf6_x1(0);\nHistory bf6_x2(0);\nHistory bf6_y1(0);\nHistory bf6_y2(0);\nHistory bf7_x1(0);\nHistory bf7_x2(0);\nHistory bf7_y1(0);\nHistory bf7_y2(0);\nHistory msl(0);\nHistory msr(0);\nHistory pkl(0);\nHistory pkr(0);\nHistory msk(0);\nHistory msm(0);\nHistory mss(0);\nHistory mlr(0);\nHistory msml(0);\nHistory mssl(0);\nHistory msb0(0);\nHistory msb1(0);\nHistory msb2(0);\nHistory msb3(0);\nHistory msb4(0);\nHistory msb5(0);\nHistory msb6(0);\nHistory msb7(0);\nHistory cfast(0);\nHistory cmom(0);\nHistory pdecay(0);\nHistory ready(0);\n\nif (ready == 0) {\n    k = tan(3.141592653589793 * 1681.974450955533 / samplerate);\n    vh = pow(10, 3.999843853973347 / 20);\n    vb = pow(vh, 0.4996667741545416);\n    a0 = 1 + k / 0.7071752369554196 + k * k;\n    ks_b0 = (vh + vb * k / 0.7071752369554196 + k * k) / a0;\n    ks_b1 = 2 * (k * k - vh) / a0;\n    ks_b2 = (vh - vb * k / 0.7071752369554196 + k * k) / a0;\n    ks_a1 = 2 * (k * k - 1) / a0;\n    ks_a2 = (1 - k / 0.7071752369554196 + k * k) / a0;\n    k = tan(3.141592653589793 * 38.13547087602444 / samplerate);\n    a0 = 1 + k / 0.5003270373238773 + k * k;\n    kh_b0 = 1;\n    kh_b1 = -2;\n    kh_b2 = 1;\n    kh_a1 = 2 * (k * k - 1) / a0;\n    kh_a2 = (1 - k / 0.5003270373238773 + k * k) / a0;\n    w0 = 2 * 3.141592653589793 * 120.0 / samplerate;\n    alpha = sin(w0) / (2 * 0.7071067811865476);\n    a0 = 1 + alpha;\n    lp_b0 = (1 - cos(w0)) / 2 / a0;\n    lp_b1 = (1 - cos(w0)) / a0;\n    lp_b2 = (1 - cos(w0)) / 2 / a0;\n    lp_a1 = -2 * cos(w0) / a0;\n    lp_a2 = (1 - alpha) / a0;\n    f0 = min(sqrt(20.0 * 60.0), 0.45 * samplerate);\n    w0 = 2 * 3.141592653589793 * f0 / samplerate;\n    q = f0 / (60.0 - 20.0);\n    alpha = sin(w0) / (2 * q);\n    a0 = 1 + alpha;\n    b0_b0 = alpha / a0;\n    b0_b1 = 0;\n    b0_b2 = 0 - alpha / a0;\n    b0_a1 = -2 * cos(w0) / a0;\n    b0_a2 = (1 - alpha) / a0;\n    f0 = min(sqrt(60.0 * 120.0), 0.45 * samplerate);\n    w0 = 2 * 3.141592653589793 * f0 / samplerate;\n    q = f0 / (120.0 - 60.0);\n    alpha = sin(w0) / (2 * q);\n    a0 = 1 + alpha;\n    b1_b0 = alpha / a0;\n    b1_b1 = 0;\n    b1_b2 = 0 - alpha / a0;\n    b1_a1 = -2 * cos(w0) / a0;\n    b1_a2 = (1 - alpha) / a0;\n    f0 = min(sqrt(120.0 * 250.0), 0.45 * samplerate);\n    w0 = 2 * 3.141592653589793 * f0 / samplerate;\n    q = f0 / (250.0 - 120.0);\n    alpha = sin(w0) / (2 * q);\n    a0 = 1 + alpha;\n    b2_b0 = alpha / a0;\n    b2_b1 = 0;\n    b2_b2 = 0 - alpha / a0;\n    b2_a1 = -2 * cos(w0) / a0;\n    b2_a2 = (1 - alpha) / a0;\n    f0 = min(sqrt(250.0 * 500.0), 0.45 * samplerate);\n    w0 = 2 * 3.141592653589793 * f0 / samplerate;\n    q = f0 / (500.0 - 250.0);\n    alpha = sin(w0) / (2 * q);\n    a0 = 1 + alpha;\n    b3_b0 = alpha / a0;\n    b3_b1 = 0;\n    b3_b2 = 0 - alpha / a0;\n    b3_a1 = -2 * cos(w0) / a0;\n    b3_a2 = (1 - alpha) / a0;\n    f0 = min(sqrt(500.0 * 2000.0), 0.45 * samplerate);\n    w0 = 2 * 3.141592653589793 * f0 / samplerate;\n    q = f0 / (2000.0 - 500.0);\n    alpha = sin(w0) / (2 * q);\n    a0 = 1 + alpha;\n    b4_b0 = alpha / a0;\n    b4_b1 = 0;\n    b4_b2 = 0 - alpha / a0;\n    b4_a1 = -2 * cos(w0) / a0;\n    b4_a2 = (1 - alpha) / a0;\n    f0 = min(sqrt(2000.0 * 5000.0), 0.45 * samplerate);\n    w0 = 2 * 3.141592653589793 * f0 / samplerate;\n    q = f0 / (5000.0 - 2000.0);\n    alpha = sin(w0) / (2 * q);\n    a0 = 1 + alpha;\n    b5_b0 = alpha / a0;\n    b5_b1 = 0;\n    b5_b2 = 0 - alpha / a0;\n    b5_a1 = -2 * cos(w0) / a0;\n    b5_a2 = (1 - alpha) / a0;\n    f0 = min(sqrt(5000.0 * 10000.0), 0.45 * samplerate);\n    w0 = 2 * 3.141592653589793 * f0 / samplerate;\n    q = f0 / (10000.0 - 5000.0);\n    alpha = sin(w0) / (2 * q);\n    a0 = 1 + alpha;\n    b6_b0 = alpha / a0;\n    b6_b1 = 0;\n    b6_b2 = 0 - alpha / a0;\n    b6_a1 = -2 * cos(w0) / a0;\n    b6_a2 = (1 - alpha) / a0;\n    f0 = min(sqrt(10000.0 * 20000.0), 0.45 * samplerate);\n    w0 = 2 * 3.141592653589793 * f0 / samplerate;\n    q = f0 / (20000.0 - 10000.0);\n    alpha = sin(w0) / (2 * q);\n    a0 = 1 + alpha;\n    b7_b0 = alpha / a0;\n    b7_b1 = 0;\n    b7_b2 = 0 - alpha / a0;\n    b7_a1 = -2 * cos(w0) / a0;\n    b7_a2 = (1 - alpha) / a0;\n    cfast = 1 - exp(-1 / (0.1 * samplerate));\n    cmom = 1 - exp(-1 / (0.4 * samplerate));\n    pdecay = exp(-1 / (0.3 * samplerate));\n    ready = 1;\n}\n\nl = in1;\nr = in2;\nmsl = msl + cfast * (l * l - msl);\nmsr = msr + cfast * (r * r - msr);\npkl = max(abs(l), pkl * pdecay);\npkr = max(abs(r), pkr * pdecay);\nkl1 = ks_b0 * l + ks_b1 * ksl_x1 + ks_b2 * ksl_x2 - ks_a1 * ksl_y1 - ks_a2 * ksl_y2;\nksl_x2 = ksl_x1;\nksl_x1 = l;\nksl_y2 = ksl_y1;\nksl_y1 = kl1;\nkl = kh_b0 * kl1 + kh_b1 * khl_x1 + kh_b2 * khl_x2 - kh_a1 * khl_y1 - kh_a2 * khl_y2;\nkhl_x2 = khl_x1;\nkhl_x1 = kl1;\nkhl_y2 = khl_y1;\nkhl_y1 = kl;\nkr1 = ks_b0 * r + ks_b1 * ksr_x1 + ks_b2 * ksr_x2 - ks_a1 * ksr_y1 - ks_a2 * ksr_y2;\nksr_x2 = ksr_x1;\nksr_x1 = r;\nksr_y2 = ksr_y1;\nksr_y1 = kr1;\nkr = kh_b0 * kr1 + kh_b1 * khr_x1 + kh_b2 * khr_x2 - kh_a1 * khr_y1 - kh_a2 * khr_y2;\nkhr_x2 = khr_x1;\nkhr_x1 = kr1;\nkhr_y2 = khr_y1;\nkhr_y1 = kr;\nmsk = msk + cmom * (kl * kl + kr * kr - msk);\nm = (l + r) * 0.5;\ns = (l - r) * 0.5;\nmsm = msm + cfast * (m * m - msm);\nmss = mss + cfast * (s * s - mss);\nmlr = mlr + cfast * (l * r - mlr);\nband0 = b0_b0 * m + b0_b1 * bf0_x1 + b0_b2 * bf0_x2 - b0_a1 * bf0_y1 - b0_a2 * bf0_y2;\nbf0_x2 = bf0_x1;\nbf0_x1 = m;\nbf0_y2 = bf0_y1;\nbf0_y1 = band0;\nmsb0 = msb0 + cfast * (band0 * band0 - msb0);\nband1 = b1_b0 * m + b1_b1 * bf1_x1 + b1_b2 * bf1_x2 - b1_a1 * bf1_y1 - b1_a2 * bf1_y2;\nbf1_x2 = bf1_x1;\nbf1_x1 = m;\nbf1_y2 = bf1_y1;\nbf1_y1 = band1;\nmsb1 = msb1 + cfast * (band1 * band1 - msb1);\nband2 = b2_b0 * m + b2_b1 * bf2_x1 + b2_b2 * bf2_x2 - b2_a1 * bf2_y1 - b2_a2 * bf2_y2;\nbf2_x2 = bf2_x1;\nbf2_x1 = m;\nbf2_y2 = bf2_y1;\nbf2_y1 = band2;\nmsb2 = msb2 + cfast * (band2 * band2 - msb2);\nband3 = b3_b0 * m + b3_b1 * bf3_x1 + b3_b2 * bf3_x2 - b3_a1 * bf3_y1 - b3_a2 * bf3_y2;\nbf3_x2 = bf3_x1;\nbf3_x1 = m;\nbf3_y2 = bf3_y1;\nbf3_y1 = band3;\nmsb3 = msb3 + cfast * (band3 * band3 - msb3);\nband4 = b4_b0 * m + b4_b1 * bf4_x1 + b4_b2 * bf4_x2 - b4_a1 * bf4_y1 - b4_a2 * bf4_y2;\nbf4_x2 = bf4_x1;\nbf4_x1 = m;\nbf4_y2 = bf4_y1;\nbf4_y1 = band4;\nmsb4 = msb4 + cfast * (band4 * band4 - msb4);\nband5 = b5_b0 * m + b5_b1 * bf5_x1 + b5_b2 * bf5_x2 - b5_a1 * bf5_y1 - b5_a2 * bf5_y2;\nbf5_x2 = bf5_x1;\nbf5_x1 = m;\nbf5_y2 = bf5_y1;\nbf5_y1 = band5;\nmsb5 = msb5 + cfast * (band5 * band5 - msb5);\nband6 = b6_b0 * m + b6_b1 * bf6_x1 + b6_b2 * bf6_x2 - b6_a1 * bf6_y1 - b6_a2 * bf6_y2;\nbf6_x2 = bf6_x1;\nbf6_x1 = m;\nbf6_y2 = bf6_y1;\nbf6_y1 = band6;\nmsb6 = msb6 + cfast * (band6 * band6 - msb6);\nband7 = b7_b0 * m + b7_b1 * bf7_x1 + b7_b2 * bf7_x2 - b7_a1 * bf7_y1 - b7_a2 * bf7_y2;\nbf7_x2 = bf7_x1;\nbf7_x1 = m;\nbf7_y2 = bf7_y1;\nbf7_y1 = band7;\nmsb7 = msb7 + cfast * (band7 * band7 - msb7);\nml = lp_b0 * m + lp_b1 * lpm_x1 + lp_b2 * lpm_x2 - lp_a1 * lpm_y1 - lp_a2 * lpm_y2;\nlpm_x2 = lpm_x1;\nlpm_x1 = m;\nlpm_y2 = lpm_y1;\nlpm_y1 = ml;\nsl = lp_b0 * s + lp_b1 * lps_x1 + lp_b2 * lps_x2 - lp_a1 * lps_y1 - lp_a2 * lps_y2;\nlps_x2 = lps_x1;\nlps_x1 = s;\nlps_y2 = lps_y1;\nlps_y1 = sl;\nmsml = msml + cfast * (ml * ml - msml);\nmssl = mssl + cfast * (sl * sl - mssl);\n\nout1 = msl;\nout2 = msr;\nout3 = pkl;\nout4 = pkr;\nout5 = msk;\nout6 = msb0;\nout7 = msb1;\nout8 = msb2;\nout9 = msb3;\nout10 = msb4;\nout11 = msb5;\nout12 = msb6;\nout13 = msb7;\nout14 = msm;\nout15 = mss;\nout16 = mlr;\nout17 = msml;\nout18 = mssl;\n",
