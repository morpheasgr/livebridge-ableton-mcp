			{
				"box": {
					"id": "obj-code",
					"maxclass": "codebox",
					"code": "// LiveBridge Unmask — generated by max_for_live/build.py, do not edit.\n// Side-chained dynamic bell cut: in1/in2 = this track, in3/in4 = side-chain.\nParam freq(80, min=20, max=8000);\nParam q(1, min=0.3, max=8);\nParam depth(6, min=0, max=18);\nParam thresh(-30, min=-60, max=0);\nParam attack(5, min=0.5, max=100);\nParam release(120, min=10, max=1000);\nHistory fs(80);\nHistory qs(1);\nHistory env(0);\nHistory bx1(0);\nHistory bx2(0);\nHistory by1(0);\nHistory by2(0);\nHistory lx1(0);\nHistory lx2(0);\nHistory ly1(0);\nHistory ly2(0);\nHistory rx1(0);\nHistory rx2(0);\nHistory ry1(0);\nHistory ry2(0);\n\nfs = fs + 0.0005 * (freq - fs);\nqs = qs + 0.0005 * (q - qs);\nw0 = twopi * min(fs, samplerate * 0.45) / samplerate;\ncw = cos(w0);\nalpha = sin(w0) / (2 * qs);\n// the side-chain's band (RBJ band-pass, 0 dB at freq)\na0 = 1 + alpha;\nsc = (in3 + in4) * 0.5;\nband = (alpha * sc - alpha * bx2 + 2 * cw * by1 - (1 - alpha) * by2) / a0;\nbx2 = bx1; bx1 = sc; by2 = by1; by1 = band;\nlvl = abs(band);\nca = exp(-1 / (attack * 0.001 * samplerate));\ncr = exp(-1 / (release * 0.001 * samplerate));\nenv = lvl > env ? ca * env + (1 - ca) * lvl : cr * env + (1 - cr) * lvl;\ncut = min(depth, max(0, atodb(max(env, 0.000001)) - thresh));\n// a bell of -cut dB at the same band on this track (RBJ peaking)\nA = pow(10, -cut / 40);\np0 = 1 + alpha / A;\nb0 = (1 + alpha * A) / p0; b1 = -2 * cw / p0; b2 = (1 - alpha * A) / p0;\na1 = b1; a2 = (1 - alpha / A) / p0;\nyl = b0 * in1 + b1 * lx1 + b2 * lx2 - a1 * ly1 - a2 * ly2;\nlx2 = lx1; lx1 = in1; ly2 = ly1; ly1 = yl;\nyr = b0 * in2 + b1 * rx1 + b2 * rx2 - a1 * ry1 - a2 * ry2;\nrx2 = rx1; rx1 = in2; ry2 = ry1; ry1 = yr;\nout1 = yl;\nout2 = yr;\nout3 = cut;\n",
					"fontface": 0,
					"fontname": "<Monospaced>",
