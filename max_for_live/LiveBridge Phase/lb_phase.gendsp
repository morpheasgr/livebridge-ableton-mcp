					"id": "obj-code",
					"maxclass": "codebox",
					"code": "// LiveBridge Phase — generated by max_for_live/build.py, do not edit.\n// Polarity, delay (0-10 ms) and up to 4 all-pass stages at freq/q (RBJ).\nParam invert(0, min=0, max=1);\nParam freq(100, min=20, max=2000);\nParam q(0.7, min=0.1, max=10);\nParam stages(0, min=0, max=4);\nParam delayms(0, min=0, max=10);\nHistory fs(100);\nHistory qs(0.7);\nHistory ds(0);\nDelay dl(4096);\nDelay dr(4096);\nHistory s0lx1(0);\nHistory s0lx2(0);\nHistory s0ly1(0);\nHistory s0ly2(0);\nHistory s0rx1(0);\nHistory s0rx2(0);\nHistory s0ry1(0);\nHistory s0ry2(0);\nHistory s1lx1(0);\nHistory s1lx2(0);\nHistory s1ly1(0);\nHistory s1ly2(0);\nHistory s1rx1(0);\nHistory s1rx2(0);\nHistory s1ry1(0);\nHistory s1ry2(0);\nHistory s2lx1(0);\nHistory s2lx2(0);\nHistory s2ly1(0);\nHistory s2ly2(0);\nHistory s2rx1(0);\nHistory s2rx2(0);\nHistory s2ry1(0);\nHistory s2ry2(0);\nHistory s3lx1(0);\nHistory s3lx2(0);\nHistory s3ly1(0);\nHistory s3ly2(0);\nHistory s3rx1(0);\nHistory s3rx2(0);\nHistory s3ry1(0);\nHistory s3ry2(0);\n\n// glide the settings so a sweep does not click\nfs = fs + 0.0005 * (freq - fs);\nqs = qs + 0.0005 * (q - qs);\nds = ds + 0.0005 * (delayms - ds);\nw0 = twopi * min(fs, samplerate * 0.45) / samplerate;\nalpha = sin(w0) / (2 * qs);\na0 = 1 + alpha;\nc0 = (1 - alpha) / a0;\nc1 = -2 * cos(w0) / a0;\npol = invert > 0.5 ? -1 : 1;\ndl.write(in1 * pol);\ndr.write(in2 * pol);\ndsamp = min(ds * samplerate / 1000, 4000);\nl = dl.read(dsamp, interp=\"linear\");\nr = dr.read(dsamp, interp=\"linear\");\nif (stages > 0.5) {\n    yl = c0 * l + c1 * s0lx1 + s0lx2 - c1 * s0ly1 - c0 * s0ly2;\n    s0lx2 = s0lx1; s0lx1 = l; s0ly2 = s0ly1; s0ly1 = yl;\n    l = yl;\n    yr = c0 * r + c1 * s0rx1 + s0rx2 - c1 * s0ry1 - c0 * s0ry2;\n    s0rx2 = s0rx1; s0rx1 = r; s0ry2 = s0ry1; s0ry1 = yr;\n    r = yr;\n}\nif (stages > 1.5) {\n    yl = c0 * l + c1 * s1lx1 + s1lx2 - c1 * s1ly1 - c0 * s1ly2;\n    s1lx2 = s1lx1; s1lx1 = l; s1ly2 = s1ly1; s1ly1 = yl;\n    l = yl;\n    yr = c0 * r + c1 * s1rx1 + s1rx2 - c1 * s1ry1 - c0 * s1ry2;\n    s1rx2 = s1rx1; s1rx1 = r; s1ry2 = s1ry1; s1ry1 = yr;\n    r = yr;\n}\nif (stages > 2.5) {\n    yl = c0 * l + c1 * s2lx1 + s2lx2 - c1 * s2ly1 - c0 * s2ly2;\n    s2lx2 = s2lx1; s2lx1 = l; s2ly2 = s2ly1; s2ly1 = yl;\n    l = yl;\n    yr = c0 * r + c1 * s2rx1 + s2rx2 - c1 * s2ry1 - c0 * s2ry2;\n    s2rx2 = s2rx1; s2rx1 = r; s2ry2 = s2ry1; s2ry1 = yr;\n    r = yr;\n}\nif (stages > 3.5) {\n    yl = c0 * l + c1 * s3lx1 + s3lx2 - c1 * s3ly1 - c0 * s3ly2;\n    s3lx2 = s3lx1; s3lx1 = l; s3ly2 = s3ly1; s3ly1 = yl;\n    l = yl;\n    yr = c0 * r + c1 * s3rx1 + s3rx2 - c1 * s3ry1 - c0 * s3ry2;\n    s3rx2 = s3rx1; s3rx1 = r; s3ry2 = s3ry1; s3ry1 = yr;\n    r = yr;\n}\nout1 = l;\nout2 = r;\n",
